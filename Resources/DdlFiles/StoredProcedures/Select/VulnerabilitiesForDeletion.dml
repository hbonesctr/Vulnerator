SELECT V.Vulnerability_ID
FROM Vulnerabilities V
         JOIN VulnerabilitiesVulnerabilitySources VVS ON V.Vulnerability_ID = VVS.Vulnerability_ID
         JOIN VulnerabilitySources VS ON VVS.VulnerabilitySource_ID = VS.VulnerabilitySource_ID
WHERE VS.SourceName IS @SourceName
  -- Only rules from an older release of this STIG, and never a rule a finding still points to.
  AND V.PublishedDate IS NOT NULL
  AND V.PublishedDate < @PublishedDate
  AND NOT EXISTS (SELECT 1 FROM UniqueFindings UF WHERE UF.Vulnerability_ID = V.Vulnerability_ID)
