INSERT INTO SoftwareHardware
VALUES (NULL,
        (
            SELECT Software_ID
            FROM Software
            WHERE DiscoveredSoftwareName = @DiscoveredSoftwareName
        ),
        (
            SELECT Hardware_ID
            FROM Hardware
            WHERE DiscoveredHostName = @DiscoveredHostName
        ),
        @InstallDate,
        (
            SELECT ReportInAccreditationGlobal
            FROM Software
            WHERE DiscoveredSoftwareName = @DiscoveredSoftwareName
        ),
        (
            SELECT ApprovedForBaselineGlobal
            FROM Software
            WHERE DiscoveredSoftwareName = @DiscoveredSoftwareName
        ),
        @BaselineApprover);